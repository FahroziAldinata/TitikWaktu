<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="48dp"
    android:paddingBottom="36dp">

    <!-- Top spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Alarm Icon with Amber Accent Frame -->
    <ImageView
        android:id="@+id/ivAlarmIcon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:padding="20dp"
        android:background="@drawable/bg_alarm_icon"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Alarm Icon" />

    <!-- Current Time -->
    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="07:00"
        android:textColor="#FFFFFF"
        android:textSize="58sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <!-- Current Date -->
    <TextView
        android:id="@+id/tvAlarmDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rabu, 23 September"
        android:textColor="#9E9E9E"
        android:textSize="15sp"
        android:fontFamily="sans-serif" />

    <!-- Middle Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <!-- Schedule Title (Amber accent) -->
    <TextView
        android:id="@+id/tvAlarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Judul Jadwal"
        android:textColor="#F59E0B"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Schedule Description -->
    <TextView
        android:id="@+id/tvAlarmDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:maxLines="3"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Bottom Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- Action Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dismiss Button (Primary Large) -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_dismiss"
            android:text="Matikan"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Snooze Button -->
        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_snooze"
            android:text="Tunda 5 Menit"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
